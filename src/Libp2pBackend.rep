#include <QVariantMap>
#include <QVariantList>

class Libp2pBackend
{
    ENUM NodeStatus {
        Stopped = 0,
        Starting = 1,
        Running = 2,
        Stopping = 3
    }

    PROP(NodeStatus status READONLY)
    PROP(QString peerId READONLY)
    PROP(QString listenAddress READONLY)
    PROP(QString uiVersion READONLY)
    PROP(int connectedPeers READONLY)
    PROP(int activeStreams READONLY)
    PROP(int gossipsubTopics READONLY)
    PROP(QVariantList subscribedTopics READONLY)
    PROP(int dhtRecords READONLY)
    PROP(int relayReservations READONLY)
    PROP(QVariantList inboundPeers READONLY)
    PROP(QVariantList outboundPeers READONLY)
    PROP(int knownPeers READONLY)
    PROP(QVariantMap metrics READONLY)
    PROP(QVariantMap lastPingResult READONLY)
    PROP(QVariantList dhtLookupResults READONLY)
    PROP(QVariantList advertisedServices READONLY)
    PROP(QVariantList discoveryResults READONLY)
    PROP(QVariantMap nodeConfig READONLY)
    PROP(QString nodeConfigJson READONLY)
    PROP(bool settingsEditable READONLY)
    PROP(int metricsRefreshIntervalMs READONLY)

    SLOT(void init(QString configJson))
    SLOT(void start())
    SLOT(void stop())
    SLOT(void refreshOverview())
    SLOT(void gossipsubSubscribe(QString topic))
    SLOT(void gossipsubUnsubscribe(QString topic))
    SLOT(void gossipsubPublish(QString topic, QString message))
    SLOT(void refreshPeers())
    SLOT(void connectPeer(QString peerId, QString multiaddr))
    SLOT(void disconnectPeer(QString peerId))
    SLOT(void refreshMetrics())
    SLOT(void pingPeer(QString peerId))
    SLOT(void dhtFindPeer(QString peerId))
    SLOT(void serviceDiscoveryAdvertise(QString serviceId, QString serviceData))
    SLOT(void serviceDiscoveryStopAdvertising(QString serviceId))
    SLOT(void serviceDiscoveryLookup(QString serviceId, QString serviceData))
    SLOT(void applyNodeConfig(QVariantMap config))
    SLOT(void restoreDefaultNodeConfig())
    SLOT(void setMetricsRefreshInterval(int intervalMs))
    SLOT(QString defaultConfigJson())
    SLOT(void logDebugInfo())

    SIGNAL(initCompleted(bool success, QString error))
    SIGNAL(startCompleted())
    SIGNAL(startFailed(QString error))
    SIGNAL(stopCompleted())
    SIGNAL(overviewUpdated(QVariantMap overview))
    SIGNAL(gossipsubTopicSubscribed(QString topic))
    SIGNAL(gossipsubTopicUnsubscribed(QString topic))
    SIGNAL(gossipsubMessagePublished(QString topic))
    SIGNAL(peersUpdated())
    SIGNAL(peerConnected(QString peerId))
    SIGNAL(peerDisconnected(QString peerId))
    SIGNAL(pingCompleted(QVariantMap result))
    SIGNAL(dhtLookupCompleted(QString peerId))
    SIGNAL(serviceAdvertised(QString serviceId))
    SIGNAL(serviceStoppedAdvertising(QString serviceId))
    SIGNAL(serviceLookupCompleted(QString serviceId))
    SIGNAL(metricsUpdated(QVariantMap metrics))
    SIGNAL(nodeConfigApplied())
    SIGNAL(nodeConfigRestored())
    SIGNAL(metricsRefreshIntervalChanged(int intervalMs))
    SIGNAL(error(QString message))
}
